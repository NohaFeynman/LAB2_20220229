<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Código -->
        <TextView
            android:id="@+id/texto_codigo_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Código: 0001"
            android:textStyle="bold"
            android:textSize="14sp" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/texto_nombre_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del equipo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <!-- Tipo -->
        <TextView
            android:id="@+id/texto_tipo_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo: Multímetro"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Estado -->
        <TextView
            android:id="@+id/texto_estado_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado: Operativo"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:textColor="#4CAF50" />

    </LinearLayout>

</androidx.cardview.widget.CardView>